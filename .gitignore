__pycache__/
*.py[cod]
.pytest_cache/
output/
live_output/
*.db
*.log

# Authorized, self-contained preservation corpus. Its state database and logs
# are evidence records and must be retained with originals and extracts.
!preservation_corpus/
!preservation_corpus/**
!preservation_corpus/state.db
!preservation_corpus/logs/
!preservation_corpus/logs/*.log

# Hash-pinned Ghidra batch records are retained reverse-engineering evidence,
# not disposable developer logs. The manifest verifier requires them in a
# clean clone and CI checkout.
!reverse_engineering/derived/**/ghidra-headless.log
!reverse_engineering/public_implementations/adp/verification/*.log

# SQLite runtime journals are regenerated and are not preservation evidence.
preservation_corpus/state.db-shm
preservation_corpus/state.db-wal

*.egg-info/
.audit/

# Local GitHub Pages viewer products; CI regenerates report data and build output.
web/report-viewer/node_modules/
web/report-viewer/dist/
web/report-viewer/public/report_data.json
