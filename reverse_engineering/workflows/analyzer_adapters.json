      "record_tool": "radare2",
      "execution_order": 10,
      "output": {"filename": "radare2-analysis.txt", "capture": "combined_stdout_stderr"},
      "load_model_compatibility": ["raw_binary_base_0_unverified"],
      "commentary_boundary": "Control-flow and instruction output are tool hypotheses at the recorded raw base; they are not recovered source or runtime semantics."
    },
    {
      "adapter_id": "architecture-static-v1",
